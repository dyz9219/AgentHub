# Hub: keep loopback for same-machine testing. Use 0.0.0.0 only with an explicit LAN token.
AGENTHUB_HOST=127.0.0.1
AGENTHUB_PORT=4310
AGENTHUB_TOKEN=replace-with-a-long-random-token
AGENTHUB_ALLOWED_HOSTS=127.0.0.1,localhost
AGENTHUB_DB_PATH=./data/agenthub.db

# Runner reads the token from this environment variable; it never writes the token into its config.
AGENTHUB_HUB_URL=http://127.0.0.1:4310
AGENTHUB_CONFIG=
